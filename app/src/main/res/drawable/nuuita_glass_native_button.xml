<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:state_pressed="true">
  <layer-list>
   <item>
    <shape android:shape="rectangle">
     <corners android:radius="22dp"/>
     <gradient android:angle="90" android:startColor="#F3B69572" android:centerColor="#E7F5DAC0" android:endColor="#F9FFFFFF"/>
     <stroke android:width="2dp" android:color="#F9FFF7E5"/>
    </shape>
   </item>
   <item android:top="3dp" android:left="8dp" android:right="8dp" android:bottom="15dp">
    <shape android:shape="rectangle"><corners android:radius="20dp"/>
     <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#B3FFFFFF"/>
    </shape>
   </item>
  </layer-list>
 </item>
 <item>
  <layer-list>
   <item>
    <shape android:shape="rectangle">
     <corners android:radius="22dp"/>
     <gradient android:angle="90" android:startColor="#C28B664A" android:centerColor="#E2D8AF7D" android:endColor="#F1F9EBCF"/>
     <stroke android:width="2dp" android:color="#FFFDF0D3"/>
    </shape>
   </item>
   <item android:top="4dp" android:left="8dp" android:right="8dp" android:bottom="13dp">
    <shape android:shape="rectangle"><corners android:radius="20dp"/>
     <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#E6FFFFFF"/>
    </shape>
   </item>
   <item>
    <shape android:shape="rectangle"><corners android:radius="22dp"/>
     <solid android:color="#00000000"/>
     <stroke android:width="1dp" android:color="#BB996B43"/>
    </shape>
   </item>
  </layer-list>
 </item>
</selector>